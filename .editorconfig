root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,hpp,ino}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# legacy firmware keeps its original formatting
[{software_stm32,software_esp32}/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
